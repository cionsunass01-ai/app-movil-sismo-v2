{
  "version": 8,
  "name": "AguaCION Emergency Offline Geometric",
  "metadata": {
    "maplibre:autogenerated": false,
    "description": "Estilo vectorial geometrico 100% offline sin endpoints externos"
  },
  "sources": {
    "lima_callao": {
      "type": "vector",
      "url": "pmtiles://file:///data/user/0/com.example.aguacion_app/app_flutter/lima_callao_z14.pmtiles"
    }
  },
  "glyphs": "file:///data/user/0/com.example.aguacion_app/app_flutter/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8fafc"
      }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "lima_callao",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#f1f5f9"
      }
    },
    {
      "id": "water_fill",
      "type": "fill",
      "source": "lima_callao",
      "source-layer": "water",
      "paint": {
        "fill-color": "#bae6fd",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "waterway_line",
      "type": "line",
      "source": "lima_callao",
      "source-layer": "water",
      "paint": {
        "line-color": "#0284c7",
        "line-width": 2.5
      }
    },
    {
      "id": "landuse_green",
      "type": "fill",
      "source": "lima_callao",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#dcfce7",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "roads_minor_casing",
      "type": "line",
      "source": "lima_callao",
      "source-layer": "roads",
      "paint": {
        "line-color": "#e2e8f0",
        "line-width": 2.5
      }
    },
    {
      "id": "roads_minor",
      "type": "line",
      "source": "lima_callao",
      "source-layer": "roads",
      "paint": {
        "line-color": "#ffffff",
        "line-width": 1.8
      }
    },
    {
      "id": "roads_major",
      "type": "line",
      "source": "lima_callao",
      "source-layer": "roads",
      "filter": ["in", "kind", "major_road", "highway"],
      "paint": {
        "line-color": "#fef08a",
        "line-width": 3.5
      }
    },
    {
      "id": "boundaries_district",
      "type": "line",
      "source": "lima_callao",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#94a3b8",
        "line-dasharray": [3, 2],
        "line-width": 1.5
      }
    },
    {
      "id": "places_labels",
      "type": "symbol",
      "source": "lima_callao",
      "source-layer": "places",
      "minzoom": 10,
      "maxzoom": 16,
      "filter": ["in", "kind", "district", "neighbourhood", "suburb", "locality", "city"],
      "layout": {
        "text-field": "{name}",
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 11,
          14, 14
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "water_labels",
      "type": "symbol",
      "source": "lima_callao",
      "source-layer": "water",
      "minzoom": 11,
      "maxzoom": 16,
      "filter": ["has", "name"],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#0284c7",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "roads_major_labels",
      "type": "symbol",
      "source": "lima_callao",
      "source-layer": "roads",
      "minzoom": 12,
      "maxzoom": 16,
      "filter": ["all", ["has", "name"], ["in", "kind", "major_road", "highway"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12, 10,
          14, 12.5
        ],
        "text-letter-spacing": 0.04,
        "symbol-spacing": 250
      },
      "paint": {
        "text-color": "#1e293b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "roads_minor_labels",
      "type": "symbol",
      "source": "lima_callao",
      "source-layer": "roads",
      "minzoom": 13.5,
      "maxzoom": 16,
      "filter": ["all", ["has", "name"], ["!in", "kind", "major_road", "highway"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13.5, 9.5,
          15, 11
        ],
        "symbol-spacing": 200
      },
      "paint": {
        "text-color": "#334155",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    }
  ]
}
